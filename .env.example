# Groq API (free at console.groq.com) — same key used in the YouTube project works fine
GROQ_API_KEY=

# Telegram — reuse the SAME values from the YouTube_Auto_Publisher project's .env
# (same Telegram account, just pointed at a different source chat below)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_SOURCE_CHAT= # numeric id of your dedicated "TikTok Queue" channel — see setup/list_telegram_chats.py

# TikTok (developers.tiktok.com, free) — run setup/get_tiktok_token.py once to get these
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
